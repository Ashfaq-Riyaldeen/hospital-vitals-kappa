{
  "uid": "ward-pipeline-health",
  "title": "Ward - Pipeline Health",
  "description": "Is the pipeline alive and keeping up? An empty ward screen and a dead pipeline look the same to a nurse; this dashboard tells them apart.",
  "tags": [
    "ward",
    "kappa"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Is data flowing?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Readings in (per s)",
      "description": "Readings delivered to Kafka by the 40 bedside monitors. Expected about 12.8/s (40 beds, one reading per 15 simulated minutes, 288x clock).",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum(rate(readings_produced_total{status=\"ok\"}[1m]))",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 10,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scores out (per s)",
      "description": "NEWS2 scores written by the v1 stream. The heartbeat for WardMonitoringSilent.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum(rate(risk_scores_written_total{scorer_version=\"v1\"}[1m]))",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 10,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dead-letter rate",
      "description": "Share of readings rejected as physically impossible. The monitors inject faults at about 1.6 %, so this should sit near that.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum(rate(readings_dlq_total[5m])) / sum(rate(readings_validated_total[5m]))",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.05,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 5,
      "type": "stat",
      "title": "End-to-end p95",
      "description": "95th percentile of real seconds from a monitor stamping a reading to its score being in Cassandra.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stream_end_to_end_seconds_bucket{scorer_version=\"v1\"}[2m])))",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 15,
                "color": "orange"
              },
              {
                "value": 30,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 6,
      "type": "stat",
      "title": "WardMonitoringSilent",
      "description": "1 while the safety alert is firing: no scores written for 1 minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum(ALERTS{alertname=\"WardMonitoringSilent\",alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Scrape targets up",
      "description": "Services Prometheus can reach, out of those it scrapes (the replay stream is excluded; it only runs during a replay).",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum(up{job!=\"ward-stream-v2\"})",
          "legendFormat": "up",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "count(up{job!=\"ward-stream-v2\"})",
          "legendFormat": "of",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "textMode": "value_and_name"
      },
      "transformations": []
    },
    {
      "id": 8,
      "type": "row",
      "title": "Throughput and latency",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Readings in, scores out, dead letters",
      "description": "If scores fall away from readings, the stream is falling behind.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum(rate(readings_produced_total{status=\"ok\"}[1m]))",
          "legendFormat": "readings in",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum(rate(risk_scores_written_total{scorer_version=\"v1\"}[1m]))",
          "legendFormat": "scores out",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum(rate(readings_dlq_total[1m]))",
          "legendFormat": "dead-lettered",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "transformations": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "End-to-end latency",
      "description": "Monitor to Cassandra, in real seconds. The 5-second micro-batch trigger sets the floor.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(stream_end_to_end_seconds_bucket{scorer_version=\"v1\"}[2m])))",
          "legendFormat": "p50",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stream_end_to_end_seconds_bucket{scorer_version=\"v1\"}[2m])))",
          "legendFormat": "p95",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "transformations": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Micro-batch duration and size",
      "description": "From the Structured Streaming query listener.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "stream_batch_duration_seconds",
          "legendFormat": "duration {{scorer_version}}",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "stream_batch_input_rows",
          "legendFormat": "rows {{scorer_version}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "transformations": []
    },
    {
      "id": 12,
      "type": "barchart",
      "title": "Injected faults vs dead-lettered, last 30 min",
      "description": "The fault injector is the control: every injected impossible reading should come out in the dead-letter queue under the same reason.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum by (defect_type) (increase(defects_injected_total[30m]))",
          "legendFormat": "injected",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum by (reason) (increase(readings_dlq_total[30m]))",
          "legendFormat": "dead-lettered",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "defect_type",
            "mode": "outer"
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Kafka topics: messages per second",
      "description": "From kafka-exporter. Alerts and dead letters are small streams beside vitals.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{topic=~\"vitals.*|labs.*|ward.*\"}[2m]))",
          "legendFormat": "{{topic}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "transformations": []
    }
  ]
}
