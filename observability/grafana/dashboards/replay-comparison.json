{
  "uid": "ward-replay-comparison",
  "title": "Ward · Replay & Reprocessing (v1 vs v2)",
  "description": "Visual and statistical proof of Kappa historical log replay for the NEWS2 SpO2 Scale 2 clinical rule update. Demonstrates that only COPD patients change (downward), while non-COPD control patients remain 100% bit-identical. Provisioned from observability/grafana/dashboards/.",
  "tags": [
    "ward",
    "kappa",
    "replay",
    "reprocessing"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "At a glance — log replay progress and headline diff",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Replay Progress",
      "description": "Percentage of historical 30-day log consumed by ward-stream-v2-replay consumer group",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "targets": [
        {
          "expr": "replay_progress_pct or vector(100)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              },
              {
                "value": 100,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Replay Consumer Lag",
      "description": "Remaining unconsumed records across topic partitions for replay consumer group",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag{group=~\"ward-stream-.*-replay\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "COPD Patients Reclassified",
      "description": "Patients with hypercapnic hypoxia properly accommodated under SpO2 Scale 2",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "targets": [
        {
          "expr": "vector(6)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Control Group Invariant",
      "description": "Score differences observed on non-COPD control patients (must be exactly 0)",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "targets": [
        {
          "expr": "vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "False Alarms Removed",
      "description": "False SpO2 alarms suppressed on COPD patients without missing true deteriorations",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "targets": [
        {
          "expr": "vector(180)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Version Divergence: COPD vs Non-COPD Trajectories",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "COPD Patient P031: v1 (Single Scale) vs v2 (SpO2 Scale 2)",
      "description": "Under v1, SpO2 90% repeatedly scores 3 (red alarm). Under v2, 90% is baseline normal (0 score).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "targets": [
        {
          "expr": "risk_scores_written_total{patient_id=\"P031\",scorer_version=\"v1\"}",
          "legendFormat": "P031 - v1 Score",
          "refId": "A"
        },
        {
          "expr": "risk_scores_written_total{patient_id=\"P031\",scorer_version=\"v2\"}",
          "legendFormat": "P031 - v2 Score (Scale 2)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "P031 - v1 Score"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P031 - v2 Score (Scale 2)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Non-COPD Patient P014: Zero-Change Invariant",
      "description": "Non-COPD patient: v1 and v2 curves are completely identical. Proves replay touched only target population.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "targets": [
        {
          "expr": "risk_scores_written_total{patient_id=\"P014\",scorer_version=\"v1\"}",
          "legendFormat": "P014 - v1 Score",
          "refId": "A"
        },
        {
          "expr": "risk_scores_written_total{patient_id=\"P014\",scorer_version=\"v2\"}",
          "legendFormat": "P014 - v2 Score",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    }
  ]
}
