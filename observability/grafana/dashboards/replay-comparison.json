{
  "uid": "ward-replay-comparison",
  "title": "Ward - Replay v1 vs v2",
  "description": "The Kappa replay: ward-stream-v2 re-reads the retained log from offset 0 with NEWS2 Scale 2 for COPD patients. Only COPD patients should change, and only downward.",
  "tags": [
    "ward",
    "kappa"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Replay progress",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Replay progress",
      "description": "Share of the log the v2 stream has re-scored, measured from its per-partition offsets against the end offsets recorded when the replay started.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "replay_progress_pct",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "orange"
              },
              {
                "value": 100,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Events remaining",
      "description": "Readings still to be re-scored.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "replay_events_remaining",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Replay duration",
      "description": "Real seconds from the start of the replay to catching up with the log.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "replay_duration_seconds",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 5,
      "type": "stat",
      "title": "v2 scores out (per s)",
      "description": "The replay stream's write rate. Very high while catching up, then the same as v1 once it is live.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum(rate(risk_scores_written_total{scorer_version=\"v2\"}[1m]))",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Log position: live stream vs replay",
      "description": "Sum of next offsets across the 6 partitions. The replay line climbs from zero to meet the live one.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum(stream_partition_offset{scorer_version=\"v1\"})",
          "legendFormat": "v1 (live)",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum(stream_partition_offset{scorer_version=\"v2\"})",
          "legendFormat": "v2 (replay)",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "transformations": []
    },
    {
      "id": 7,
      "type": "row",
      "title": "Did the right patients change?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "P031 (COPD): NEWS2 under v1 and v2",
      "description": "Stable at SpO2 89-91 %. Scale 1 (v1) scores that saturation as abnormal; Scale 2 (v2) does not.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "patient_news2{patient_id=\"P031\"}",
          "legendFormat": "{{scorer_version}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 5,
                "color": "orange"
              },
              {
                "value": 7,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "transformations": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "P014 (sepsis, not COPD): NEWS2 under v1 and v2",
      "description": "The control. The two lines must lie on top of each other.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "patient_news2{patient_id=\"P014\"}",
          "legendFormat": "{{scorer_version}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 5,
                "color": "orange"
              },
              {
                "value": 7,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "transformations": []
    },
    {
      "id": 10,
      "type": "table",
      "title": "Current NEWS2 difference per patient (v2 minus v1)",
      "description": "Latest score under v2 minus latest under v1, patients that differ only. Every row should be a COPD patient with a negative number.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "patient_news2{scorer_version=\"v2\"} - ignoring(scorer_version) patient_news2{scorer_version=\"v1\"} != 0",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "patient_id": "Patient",
              "Value": "v2 minus v1"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "v2 minus v1"
              }
            ]
          }
        }
      ]
    }
  ]
}
