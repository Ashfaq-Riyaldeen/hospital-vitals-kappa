{
  "uid": "ward-clinical-monitor",
  "title": "Ward - Clinical Monitor (v1, live)",
  "description": "Which patients show concerning vital-sign trends right now, and how do the latest lab results change their risk? Every number comes from the stream's per-patient gauges; if the stream stops they disappear rather than freeze.",
  "tags": [
    "ward",
    "kappa"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "The ward right now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Beds reporting",
      "description": "Patients with a current score from the stream. 40 when everything is healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "count(patient_news2{scorer_version=\"v1\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 40,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "NEWS2 7 or more",
      "description": "Patients whose latest NEWS2 is 7+: emergency response threshold.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "count(patient_news2{scorer_version=\"v1\"} >= 7) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 4,
      "type": "stat",
      "title": "NEWS2 5 to 6",
      "description": "Patients whose latest NEWS2 is 5 or 6: urgent review threshold.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "count((patient_news2{scorer_version=\"v1\"} >= 5) < 7) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Mean composite risk",
      "description": "Average of NEWS2 plus lab contribution across the ward snapshot (from the API).",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "serving_mean_composite_risk",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 3,
                "color": "orange"
              },
              {
                "value": 5,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Scored without fresh labs",
      "description": "Patients whose latest score used vitals only, because no lab result from the last two simulated days was available.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "serving_stale_labs_patients",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 10,
                "color": "orange"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Alerts in last 15 min",
      "description": "New clinical alert episodes raised by the stream in the last 15 real minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum(increase(clinical_alerts_emitted_total[15m])) or vector(0)",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "transformations": []
    },
    {
      "id": 8,
      "type": "row",
      "title": "Worst patient first",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "Ward list, highest composite risk first",
      "description": "One row per bed, sorted by composite risk. NEWS2 is the bedside score; the difference is what the latest labs add.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 10,
        "h": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "patient_composite_risk{scorer_version=\"v1\"}",
          "legendFormat": "composite",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "patient_news2{scorer_version=\"v1\"}",
          "legendFormat": "news2",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 5,
                "color": "orange"
              },
              {
                "value": 7,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "scorer_version": true
            },
            "renameByName": {
              "patient_id": "Patient",
              "Value #A": "Composite risk",
              "Value #B": "NEWS2"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Composite risk",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Scripted patients: NEWS2 over time",
      "description": "P014 develops sepsis on simulated day 2 from 08:00. P031 is a stable COPD patient at SpO2 89-91 %. P007 has one heart-rate spike on day 1 at 14:00.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 10,
        "y": 6,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "patient_news2{scorer_version=\"v1\",patient_id=~\"P014|P031|P007\"}",
          "legendFormat": "{{patient_id}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 5,
                "color": "orange"
              },
              {
                "value": 7,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "transformations": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Alerts raised, by type",
      "description": "New alert episodes per type. One episode per condition, not one per reading.",
      "datasource": {
        "type": "prometheus",
        "uid": "ward-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ward-prom"
          },
          "expr": "sum by (type) (increase(clinical_alerts_emitted_total[2m]))",
          "legendFormat": "{{type}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "transformations": []
    }
  ]
}
