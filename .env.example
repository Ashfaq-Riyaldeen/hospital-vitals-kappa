# Copy to .env before `make up`. Every value here is also the code default in
# ward/settings.py -- this file exists so the whole configuration is visible in one
# place rather than scattered across dataclass defaults.
#
# DEMO CREDENTIALS. Nothing here is a secret and nothing here should ever be used
# outside a local teaching stack.

# --- the simulated clock ------------------------------------------------
# One simulated day in 300 real seconds = a 288x speed-up.
# Changing this WITHOUT revisiting PROC_WATERMARK_SIM_MINUTES will fail at start-up:
# ward/settings.py validates the coupling. See plan/03 section 3.3.
SIM_DAY_SECONDS=300
SIM_EPOCH_SIM=2026-04-01T00:00:00Z
SIM_STATE_PATH=/state/sim_epoch.json

# --- the ward -----------------------------------------------------------
WARD_BEDS=40
WARD_READING_INTERVAL_SIM_MINUTES=15
WARD_RANDOM_SEED=42

# --- kafka --------------------------------------------------------------
KAFKA_BOOTSTRAP=kafka:29092
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8181
KAFKA_VITALS_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
# Retention IS the historical store under Kappa. Shortening this does not save
# disk; it deletes the system's memory and makes replay impossible.
KAFKA_VITALS_RETENTION_SIM_DAYS=30

# --- processing ---------------------------------------------------------
# 60 simulated minutes = 12.5 REAL seconds of lateness tolerance at 288x.
PROC_WATERMARK_SIM_MINUTES=60
PROC_TREND_WINDOW_SIM_HOURS=4
PROC_TRIGGER_SECONDS=5
PROC_MIN_READINGS_FOR_TREND=4

# --- storage ------------------------------------------------------------
STORE_CASSANDRA_HOSTS=cassandra
STORE_KEYSPACE=ward
# TTL, never DELETE. If the stream stops, the ward screen empties within this
# window -- which is unmistakable, where a frozen screen looks like a stable ward.
STORE_SNAPSHOT_TTL_SECONDS=120

# --- observability ------------------------------------------------------
OBS_LOG_LEVEL=INFO
OBS_LOG_JSON=true
