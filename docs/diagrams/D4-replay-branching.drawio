<mxfile host="build_drawio.py"><diagram id="D4-replay-branching" name="D4-replay-branching"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;vitals.readings.v1&lt;/b&gt;: every reading, kept for 30 simulated days   (offset 0  ───────────────────────────────►  newest)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="900" height="45" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;ward-stream&lt;/b&gt; (NEWS2 v1)&lt;br&gt;reads the newest readings, live" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="130" width="300" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;ward-stream-v2&lt;/b&gt; (NEWS2 v2: Scale 2 for COPD)&lt;br&gt;same code, starts at offset 0, catches up,&lt;br&gt;then runs live beside v1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="360" height="70" as="geometry"/></mxCell><mxCell id="c4" value="live" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;jumpStyle=arc;jumpSize=8;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="replay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;jumpStyle=arc;jumpSize=8;exitX=0.1;exitY=1;entryX=0.3;entryY=0;dashed=1;" edge="1" parent="1" source="c1" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;Cassandra&lt;/b&gt;: v1 rows and v2 rows side by side&lt;br&gt;(scorer_version is part of every score key, so nothing is overwritten)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="240" y="240" width="500" height="55" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;jumpStyle=arc;jumpSize=8;dashed=1;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;compare_versions&lt;/b&gt;&lt;br&gt;every reading scored by both,&lt;br&gt;NEWS2 v1 vs v2" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="240" height="70" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="only COPD patients&lt;br&gt;changed, and only&lt;br&gt;downward?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="325" width="170" height="100" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="stop: the new rule&lt;br&gt;does something&lt;br&gt;unexpected" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="470" width="130" height="70" as="geometry"/></mxCell><mxCell id="c14" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;clinician approves&lt;/b&gt;&lt;br&gt;(the Airflow run stops&lt;br&gt;here and waits)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="570" y="340" width="170" height="70" as="geometry"/></mxCell><mxCell id="c16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;cutover&lt;/b&gt;: the API serves v2&lt;br&gt;(make cutover VERSION=v2)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="800" y="340" width="200" height="70" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Rollback&lt;/b&gt; is the same switch back to v1: the v1 rows were never touched." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="430" width="200" height="60" as="geometry"/></mxCell><mxCell id="c20" value="Colour key" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="40" width="140" height="20" as="geometry"/></mxCell><mxCell id="c21" value="Streaming" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="64" width="150" height="22" as="geometry"/></mxCell><mxCell id="c22" value="Storage and serving" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="90" width="150" height="22" as="geometry"/></mxCell><mxCell id="c23" value="Orchestration" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="116" width="150" height="22" as="geometry"/></mxCell><mxCell id="c24" value="Observability" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x=