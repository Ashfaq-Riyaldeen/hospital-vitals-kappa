<mxfile host="build_drawio.py"><diagram id="D5-cassandra-tables" name="D5-cassandra-tables"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;vitals_by_patient&lt;/b&gt;&lt;br&gt;partition: patient_id&lt;br&gt;order: measured_at, newest first&lt;br&gt;answers: recent readings" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="350" height="100" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;ward_risk_snapshot&lt;/b&gt;&lt;br&gt;partition: ward_id, scorer_version&lt;br&gt;order: risk_score, highest first&lt;br&gt;TTL 120 s&lt;br&gt;answers: ward list, sickest first" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="380" y="0" width="350" height="100" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;risk_scores_by_patient&lt;/b&gt;&lt;br&gt;partition: patient_id, scorer_version&lt;br&gt;order: scored_at, newest first&lt;br&gt;answers: score history per version" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="0" y="120" width="350" height="100" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;alerts_by_ward&lt;/b&gt;&lt;br&gt;partition: ward_id, sim_date, scorer_version&lt;br&gt;order: alert_time, newest first&lt;br&gt;TTL 3 h&lt;br&gt;answers: today's alerts" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="350" height="100" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;labs_by_patie