<mxfile host="build_drawio.py"><diagram id="D5-cassandra-tables" name="D5-cassandra-tables"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;vitals_by_patient&lt;/b&gt;&lt;hr&gt;partition key: &lt;i&gt;patient_id&lt;/i&gt;&lt;br&gt;clustering: &lt;i&gt;measured_at DESC&lt;/i&gt;&lt;hr&gt;Q1: a patient's recent readings" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="300" height="125" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;ward_risk_snapshot&lt;/b&gt;&lt;hr&gt;partition key: &lt;i&gt;ward_id, scorer_version&lt;/i&gt;&lt;br&gt;clustering: &lt;i&gt;risk_score DESC, patient_id&lt;/i&gt;&lt;br&gt;TTL 120 s&lt;hr&gt;Q2: the ward list, worst first" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="360" y="30" width="300" height="125" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;risk_scores_by_patient&lt;/b&gt;&lt;hr&gt;partition key: &lt;i&gt;patient_id, scorer_version&lt;/i&gt;&lt;br&gt;clustering: &lt;i&gt;scored_at DESC&lt;/i&gt;&lt;hr&gt;Q3: a patient's score history,&lt;br&gt;per rule version" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="690" y="30" width="300" height="125" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;alerts_by_ward&lt;/b&gt;&lt;hr&gt;partition key: &lt;i&gt;ward_id, sim_date, scorer_version&lt;/i&gt;&lt;br&gt;clustering: &lt;i&gt;alert_time DESC, alert_id&lt;/i&gt;&lt;br&gt;TTL 3 h&lt;hr&gt;Q4: today's alerts on the ward" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="175" width="300" height="125" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;labs_by_patient&lt;/b&gt;&lt;hr&gt;partition key: &lt;i&gt;patient_id&lt;/i&gt;&lt;br&gt;clustering: &lt;i&gt;test_type, collected_at DESC&lt;/i&gt;&lt;hr&gt;Q5: a patient's lab results" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="360" y="175" width="300" height="125" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;daily_patient_summary&lt;/b&gt;&lt;hr&gt;partition key: &lt;i&gt;ward_id, sim_date&lt;/i&gt;&lt;br&gt;clustering: &lt;i&gt;patient_id, scorer_version&lt;/i&gt;&lt;hr&gt;Q6: the daily PDF report" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="690" y="175" width="300" height="125" as="geometry"/></mxCell><mxCell id="c7" value="Each table is shaped for exactly one question, so every read touches one partition and none needs ALLOW FILTERING. Rows that go stale expire by TTL instead of DELETE, which would leave tombstones behind." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="960" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
