<mxfile host="build_drawio.py"><diagram id="D6-one-reading" name="D6-one-reading"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;a reading arrives&lt;/b&gt;&lt;br&gt;(Kafka record)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="160" height="55" as="geometry"/></mxCell><mxCell id="c2" value="can it be decoded?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="180" height="90" as="geometry"/></mxCell><mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="vitals.readings.dlq&lt;br&gt;(UNDECODABLE)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="148" width="190" height="55" as="geometry"/></mxCell><mxCell id="c5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="seen this reading id&lt;br&gt;before?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="255" width="180" height="90" as="geometry"/></mxCell><mxCel